+/* A durable set marker surrounds all shard writes, including appends. */
+void native_hdf5_set_record(const char *base, const char *generation, int count, const char *state)
+{
+  std::string target = std::string(base) + ".publication.json";
+  std::string pattern = target + ".partial.XXXXXX";
+  char *stage = strdup(pattern.c_str());
+  if(!stage) Terminate("cannot allocate HDF5 set marker path");
+  int fd = mkstemp(stage);
+  if(fd < 0) Terminate("cannot reserve HDF5 set marker");
+  FILE *stream = fdopen(fd, "w");
+  if(!stream) Terminate("cannot open HDF5 set marker stream");
+  if(fprintf(stream, "{\"schema\":\"native-hdf5-set-publication-v1\",\"state\":\"%s\",\"generation\":\"%s\",\"shard_count\":%d}\n",
+             state, generation, count) < 0 || fflush(stream) != 0 || fsync(fd) != 0)
+    Terminate("cannot durably write HDF5 set marker");
+  if(fclose(stream) != 0) Terminate("cannot close HDF5 set marker");
+  native_publish_hdf5_file(stage, target.c_str());
+  free(stage);
+}
