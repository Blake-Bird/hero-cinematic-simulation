 herr_t my_H5Fclose(hid_t file_id, const char *fname)
 {
+  unsigned int intent = 0;
+  if(H5Fget_intent(file_id, &intent) < 0)
+    Terminate("HDF5: cannot determine file intent for %s", fname);
+  if((intent & H5F_ACC_RDWR) && H5Fflush(file_id, H5F_SCOPE_GLOBAL) < 0)
+    Terminate("HDF5: cannot flush output %s", fname);
   herr_t status = H5Fclose(file_id);
   if(status < 0)
     {
       H5Eset_auto(H5E_DEFAULT, NULL, NULL);
       Terminate("Error detected in HDF5: unable to close file %s\n", fname);
     }
-  return status;
+  if(intent & H5F_ACC_RDWR)
+    {
+      int descriptor = open(fname, O_RDONLY);
+      if(descriptor < 0 || fsync(descriptor) != 0)
+        Terminate("HDF5: cannot durably flush output %s", fname);
+      if(close(descriptor) != 0) Terminate("HDF5: cannot close flushed output %s", fname);
+    }
+  return status;
+}
+
+/* Each shard is immutable until close/flush, then published by rename.
+ * Complete multi-shard epoch validation remains the caller's responsibility. */
+void native_publish_hdf5_file(const char *stage, const char *target)
+{
+  struct stat previous;
+  if(lstat(target, &previous) == 0)
+    {
+      if(!S_ISREG(previous.st_mode) && !S_ISLNK(previous.st_mode))
+        Terminate("HDF5: output target is not a regular file/link: %s", target);
+      char archive[MAXLEN_PATH_EXTRA];
+      if(snprintf(archive, sizeof(archive), "%s.previous.XXXXXX", target) >= (int)sizeof(archive))
+        Terminate("HDF5: previous output path too long");
+      int descriptor = mkstemp(archive);
+      if(descriptor < 0) Terminate("HDF5: cannot reserve prior output archive");
+      if(close(descriptor) != 0 || unlink(archive) != 0 || link(target, archive) != 0)
+        Terminate("HDF5: cannot preserve prior output %s", target);
+    }
+  else if(errno != ENOENT) Terminate("HDF5: cannot inspect output %s", target);
+  std::string directory(target);
+  size_t slash = directory.find_last_of('/');
+  directory = slash == std::string::npos ? "." : slash == 0 ? "/" : directory.substr(0, slash);
+  int descriptor = open(directory.c_str(), O_RDONLY);
+  if(descriptor < 0) Terminate("HDF5: cannot open output directory");
+  if(fsync(descriptor) != 0 && errno != EINVAL && errno != ENOTSUP)
+    Terminate("HDF5: cannot flush prior output archive");
+  if(rename(stage, target) != 0) Terminate("HDF5: cannot publish staged output %s", target);
+  if(fsync(descriptor) != 0 && errno != EINVAL && errno != ENOTSUP)
+    Terminate("HDF5: cannot flush output publication");
+  if(close(descriptor) != 0) Terminate("HDF5: cannot close output directory");
 }
 
