+// DarkMatterSim transfer-file adapter for model-matched CLASS/AxiCLASS input.
+// The input table is generated by cosmology.write_monofonic_ic_transfer_table
+// and uses N-body-gauge species transfers at the simulation start redshift.
+
+#include <cmath>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#include <transfer_function_plugin.hh>
+#include <math/interpolate.hh>
+
+class transfer_DMS_file_plugin : public TransferFunction_plugin
+{
+private:
+  using TransferFunction_plugin::cosmo_params_;
+
+  interpolated_function_1d<true, false, false> delta_c_, delta_b_, theta_c_, theta_b_;
+  double m_kmin_ = 0.0;
+  double m_kmax_ = 0.0;
+  double m_tnorm_ = 0.0;
+  double m_fHa_start_ = 0.0;
+
+  void read_table(const std::string& filename)
+  {
+    std::ifstream input(filename.c_str());
+    if (!input.good())
+      throw std::runtime_error("Could not open DarkMatterSim transfer table '" + filename + "'");
+
+    const std::string expected_model = pcf_->get_value<std::string>("cosmology", "input_model");
+    const double expected_redshift = pcf_->get_value<double>("setup", "zstart");
+    bool has_schema = false;
+    bool has_nbody_gauge = false;
+    bool has_matching_model = false;
+    bool has_matching_redshift = false;
+    bool has_growth_rate = false;
+    bool has_aH = false;
+    double growth_rate_start = 0.0;
+    double aH_start = 0.0;
+    std::vector<double> k, dc, db, tc, tb;
+    std::string line;
+    while (std::getline(input, line))
+    {
+      if (line.empty())
+        continue;
+      if (line[0] == '#')
+      {
+        if (line.find("DarkMatterSim monofonIC transfer table v1") != std::string::npos)
+          has_schema = true;
+        if (line.find("gauge: N-body") != std::string::npos)
+          has_nbody_gauge = true;
+        if (line.find("Model: " + expected_model + ";") != std::string::npos)
+          has_matching_model = true;
+        const std::string growth_marker = "growth_f_start: ";
+        const auto growth_pos = line.find(growth_marker);
+        if (growth_pos != std::string::npos)
+        {
+          try
+          {
+            const double value = std::stod(line.substr(growth_pos + growth_marker.size()));
+            if (std::isfinite(value) && value > 0.0)
+            {
+              growth_rate_start = value;
+              has_growth_rate = true;
+            }
+          }
+          catch (const std::exception&)
+          {
+            has_growth_rate = false;
+          }
+        }
+        const std::string aH_marker = "aH_start_Mpc^-1: ";
+        const auto aH_pos = line.find(aH_marker);
+        if (aH_pos != std::string::npos)
+        {
+          try
+          {
+            const double value = std::stod(line.substr(aH_pos + aH_marker.size()));
+            if (std::isfinite(value) && value > 0.0)
+            {
+              aH_start = value;
+              has_aH = true;
+            }
+          }
+          catch (const std::exception&)
+          {
+            has_aH = false;
+          }
+        }
+        const std::string redshift_marker = "redshift: ";
+        const auto redshift_pos = line.find(redshift_marker);
+        if (redshift_pos != std::string::npos)
+        {
+          try
+          {
+            const double table_redshift = std::stod(line.substr(redshift_pos + redshift_marker.size()));
+            has_matching_redshift = std::isfinite(table_redshift)
+                && std::abs(table_redshift - expected_redshift) <= 1.0e-8;
+          }
+          catch (const std::exception&)
+          {
+            has_matching_redshift = false;
+          }
+        }
+        continue;
+      }
+
+      std::stringstream row(line);
+      double wave_number, delta_dark, delta_baryon, theta_dark, theta_baryon;
+      if (!(row >> wave_number >> delta_dark >> delta_baryon >> theta_dark >> theta_baryon))
+        throw std::runtime_error("Corrupt DarkMatterSim transfer row in '" + filename + "'");
+      std::string trailing;
+      if (row >> trailing)
+        throw std::runtime_error("Unexpected extra column in DarkMatterSim transfer table '" + filename + "'");
+      if (!(std::isfinite(wave_number) && wave_number > 0.0
+            && std::isfinite(delta_dark) && std::isfinite(delta_baryon)
+            && std::isfinite(theta_dark) && std::isfinite(theta_baryon)))
+        throw std::runtime_error("Non-finite or non-positive k value in DarkMatterSim transfer table '" + filename + "'");
+      if (!k.empty() && wave_number <= k.back())
+        throw std::runtime_error("DarkMatterSim transfer k values must be strictly increasing in '" + filename + "'");
+      k.push_back(wave_number);
+      dc.push_back(delta_dark);
+      db.push_back(delta_baryon);
+      tc.push_back(theta_dark);
+      tb.push_back(theta_baryon);
+    }
+
+    m_fHa_start_ = growth_rate_start * aH_start;
+    if (!has_schema || !has_nbody_gauge || !has_matching_model || !has_matching_redshift
+        || !has_growth_rate || !has_aH || !(std::isfinite(m_fHa_start_) && m_fHa_start_ > 0.0))
+      throw std::runtime_error(
+          "DarkMatterSim transfer table schema, N-body gauge, model, start redshift, or velocity-normalization metadata is invalid");
+    if (k.size() < 6)
+      throw std::runtime_error("DarkMatterSim transfer table must contain at least six numeric rows");
+
+    delta_c_.set_data(k, dc);
+    delta_b_.set_data(k, db);
+    theta_c_.set_data(k, tc);
+    theta_b_.set_data(k, tb);
+    // Keep away from the natural-spline endpoints, as the bundled CLASS
+    // plugin does. The Python staging gate verifies mesh coverage beforehand.
+    m_kmin_ = k[1];
+    m_kmax_ = k[k.size() - 2];
+  }
+
+public:
+  transfer_DMS_file_plugin(config_file& cf, const cosmology::parameters& cosmo_params)
+      : TransferFunction_plugin(cf, cosmo_params)
+  {
+    const std::string filename = pcf_->get_value<std::string>("cosmology", "transfer_file");
+    read_table(filename);
+
+    const double h = cosmo_params_["h"];
+    const double k_p = cosmo_params_["k_p"] / h;
+    const double A_s = cosmo_params_["A_s"];
+    const double n_s = cosmo_params_["n_s"];
+    if (!(std::isfinite(h) && h > 0.0 && std::isfinite(k_p) && k_p > 0.0
+          && std::isfinite(A_s) && A_s > 0.0 && std::isfinite(n_s)))
+      throw std::runtime_error("The CLASS/AxiCLASS transfer-file path requires finite h, k_p, n_s, and positive A_s");
+    m_tnorm_ = std::sqrt(
+        2.0 * M_PI * M_PI * A_s * std::pow(1.0 / k_p, n_s - 1.0)
+        / std::pow(2.0 * M_PI, 3.0));
+
+    tf_distinct_ = true;
+    tf_withvel_ = true;
+    tf_withtotal0_ = false;
+    tf_isnormalised_ = true;
+    music::ilog.Print("Loaded %s N-body-gauge transfer table over k=[%.8g, %.8g] h/Mpc",
+                      pcf_->get_value<std::string>("cosmology", "input_model").c_str(), m_kmin_, m_kmax_);
+  }
+
+  inline double compute(double k, tf_type type) const
+  {
+    if (!std::isfinite(k) || k < 0.0)
+      throw std::runtime_error("monofonIC requested an invalid wavenumber from the transfer table");
+    if (k == 0.0 || k < m_kmin_ || k > m_kmax_)
+      return 0.0;
+
+    const double fb = cosmo_params_["f_b"];
+    const double fc = cosmo_params_["f_c"];
+    const double inv_k2 = 1.0 / (k * k);
+    // The sign and k^-2 conversion match transfer_CLASS::run_ClassEngine:
+    // its CLASS k is h times the table k, followed by multiplication by h^2.
+    const double d_c = -delta_c_(k) * inv_k2 * m_tnorm_;
+    const double d_b = -delta_b_(k) * inv_k2 * m_tnorm_;
+    // CLASS tabulates the N-body-gauge velocity divergence in Mpc^-1.
+    // monofonIC's velocity transfer is the displacement potential
+    // -theta/(k^2 f aH), because it applies its own f aH velocity factor.
+    const double t_c = -theta_c_(k) * inv_k2 / m_fHa_start_ * m_tnorm_;
+    const double t_b = -theta_b_(k) * inv_k2 / m_fHa_start_ * m_tnorm_;
+    const double d_m = fc * d_c + fb * d_b;
+    const double t_m = fc * t_c + fb * t_b;
+
+    switch (type)
+    {
+      case delta_matter:
+      case delta_matter0: return d_m;
+      case delta_cdm:
+      case delta_cdm0: return d_c;
+      case delta_baryon:
+      case delta_baryon0: return d_b;
+      case theta_matter:
+      case theta_matter0: return t_m;
+      case theta_cdm:
+      case theta_cdm0: return t_c;
+      case theta_baryon:
+      case theta_baryon0: return t_b;
+      case delta_bc: return d_b - d_c;
+      case theta_bc: return t_b - t_c;
+      default: throw std::runtime_error("Invalid transfer type requested from DarkMatterSim table");
+    }
+  }
+
+  inline double get_kmin(void) const { return m_kmin_; }
+  inline double get_kmax(void) const { return m_kmax_; }
+};
+
+namespace
+{
+  TransferFunction_plugin_creator_concrete<transfer_DMS_file_plugin> creator("DMS_file");
+}
