+        // the CDM+baryon source requested by this transfer component.
+        if (ba_.N_ncdm > 0)
+        {
+          call_perturb_sources_at_tau(index_md, 0, pt_.index_tp_delta_cb, tau, &d_tot[0]);
+          call_perturb_sources_at_tau(index_md, 0, pt_.index_tp_theta_cb, tau, &t_tot[0]);
+        }
+        else
+        {
+          // In a no-ncdm model CLASS may not allocate matter-velocity
+          // indices.  The baryon+CDM density and velocity are the exact
+          // density-weighted combination of the already requested species.
+          for (int index_k = 0; index_k < pt_.k_size[index_md]; index_k++)
+          {
+            d_tot[index_k] = f_c_ * d_cdm[index_k] + f_b_ * d_b[index_k];
+            t_tot[index_k] = f_c_ * t_cdm[index_k] + f_b_ * t_b[index_k];
+          }
+        }
         break;
       case cosmology::TOTAL_ :
         call_perturb_sources_at_tau(index_md, 0, pt_.index_tp_delta_tot, tau, &d_tot[0]);
