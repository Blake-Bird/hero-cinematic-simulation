+struct GrowthBackgroundTable {
+    std::vector<double> a;
+    std::vector<double> E;
+    std::vector<double> D;
+    std::vector<double> f;
+
+    bool empty() const noexcept { return a.empty(); }
+
+    static double interpolate(const std::vector<double> &x, const std::vector<double> &values,
+                               double at, bool logarithmic_value)
+    {
+        if (x.empty() || values.size() != x.size() || !(at > 0.0))
+            throw std::runtime_error("Invalid monofonIC growth-background interpolation request");
+        if (at <= x.front()) return values.front();
+        if (at >= x.back()) return values.back();
+        const auto upper = std::lower_bound(x.begin(), x.end(), at);
+        const size_t right = static_cast<size_t>(upper - x.begin());
+        if (*upper == at) return values[right];
+        const size_t left = right - 1;
+        const double x0 = std::log(x[left]);
+        const double x1 = std::log(x[right]);
+        const double t = (std::log(at) - x0) / (x1 - x0);
+        if (logarithmic_value)
+            return std::exp(std::log(values[left]) + t * (std::log(values[right]) - std::log(values[left])));
+        return values[left] + t * (values[right] - values[left]);
+    }
+
+    double expansion(double at) const { return interpolate(a, E, at, true); }
+    double growth(double at) const { return interpolate(a, D, at, true); }
+    double growth_rate(double at) const { return interpolate(a, f, at, false); }
+};
