diff --git a/shipped/third_party/random123/include/Random123/features/nvccfeatures.h b/shipped/third_party/random123/include/Random123/features/nvccfeatures.h
new file mode 100644
index 0000000..591839d
--- /dev/null
+++ b/shipped/third_party/random123/include/Random123/features/nvccfeatures.h
@@ -0,0 +1,129 @@
+/*
+Copyright 2010-2011, D. E. Shaw Research.
+All rights reserved.
+
+Redistribution and use in source and binary forms, with or without
+modification, are permitted provided that the following conditions are
+met:
+
