+/* Native directed small-angle drag plus transverse momentum diffusion.
+ * Relative velocity shrinks along its old direction by transfer_depth, and
+ * receives an isotropic transverse increment restoring the removed kinetic
+ * energy. The mass-weighted pair COM is retained by commit_pair_rotation.
+ * This is a small-angle effective operator, not sampled microscopic events.
+ * Reference: Fischer et al. 2012.10277; Arido et al. 2410.07175.
+ */
+#ifndef RESEARCH_FREQUENT_SIDM_PAIR_H
+#define RESEARCH_FREQUENT_SIDM_PAIR_H
+#include "research_rare_pair.h"
+#include "research_angular_transport.h"
+
+namespace research_sidm {
+inline pair_result apply_frequent_pair(pair_particle &left,pair_particle &right,const rare_parameters &parameters,
+                                      double small_angle_cutoff,double maximum_transfer_depth,double maximum_moment_ratio,
+                                      std::uint64_t integer_interval,std::uint64_t &persistent_attempt,
+                                      double native_time,double scale_factor,std::uint32_t logging_rank,
+                                      std::uint64_t &persistent_update_sequence,research_sidm_event_log *log)
+{
+  source_cpu_scope resource_scope(parameters.resources,2);
+  if(left.id>=right.id)throw std::runtime_error("Frequent SIDM requires one canonical unordered pair");
+  require_positive(left.mass_msun,"Frequent SIDM left macro mass invalid");
+  require_positive(right.mass_msun,"Frequent SIDM right macro mass invalid");
+  require_positive(parameters.physical_dt_seconds,"Frequent SIDM actual physical interval invalid");
+  require_positive(parameters.cross_section_per_mass_cm2_g,"Frequent SIDM cross section invalid",true);
+  require_positive(parameters.differential_normalization,"Frequent SIDM differential normalization invalid",true);
+  require_positive(parameters.differential_speed_scale,"Frequent SIDM differential speed mapping invalid");
+  require_positive(parameters.kernel_overlap_inverse_cm3,"Frequent SIDM kernel overlap invalid",true);
+  require_positive(parameters.macro_mass_relative_tolerance,"Frequent SIDM macro mass tolerance invalid",true);
+  require_positive(parameters.conservation_relative_tolerance,"Frequent SIDM conservation bound invalid");
+  require_positive(parameters.energy_absolute_floor,"Frequent SIDM energy floor invalid");
+  require_positive(parameters.momentum_absolute_floor,"Frequent SIDM momentum floor invalid");
+  require_positive(maximum_transfer_depth,"Frequent SIDM source-step limit invalid");
+  require_positive(maximum_moment_ratio,"Frequent SIDM angular approximation limit invalid");
+  if(maximum_transfer_depth>=1 || maximum_moment_ratio>=2)
+    throw std::runtime_error("Frequent SIDM controls lie outside small-increment physical domain");
+  if(left.mass_msun!=right.mass_msun)
+    throw std::runtime_error("Frequent SIDM unequal-resolution pair requires calibrated weighted operator");
+  if(persistent_attempt==std::numeric_limits<std::uint64_t>::max())
+    throw std::runtime_error("Frequent SIDM persistent update counter exhausted");
+  vector3 relative;
+  for(int k=0;k<3;k++) {
+    if(!std::isfinite(left.velocity_kms[k]) || !std::isfinite(right.velocity_kms[k]))
+      throw std::runtime_error("Frequent SIDM native pair velocity invalid");
+    relative[k]=left.velocity_kms[k]-right.velocity_kms[k];
+  }
+  const double speed=norm(relative);
+  const bool disabled=parameters.differential_model?parameters.differential_normalization==0:
+      parameters.cross_section_per_mass_cm2_g==0;
+  if(speed==0 || disabled || parameters.kernel_overlap_inverse_cm3==0) {
+    pair_result result;result.relative_speed_before_kms=speed;result.relative_speed_after_kms=speed;
+    ++persistent_attempt;return result;
+  }
+  const auto moments=pair_angular_transport(parameters,speed,small_angle_cutoff);
+  if(moments.neglected_moment_ratio>maximum_moment_ratio)
+    throw std::runtime_error("Frequent SIDM angular model exceeds the frozen neglected-moment ratio; use rare or split controls");
+  const double sigma=parameters.differential_model?parameters.differential_normalization*parameters.differential_model->total_cross_section(pair_differential_speed(parameters,speed)):parameters.cross_section_per_mass_cm2_g;
+  const long double total_depth=static_cast<long double>(sigma)*left.mass_msun*
+      1.98847e33L*speed*1.e5L*parameters.kernel_overlap_inverse_cm3*parameters.physical_dt_seconds;
+  const long double transfer_depth=total_depth*moments.small_transfer;
+  if(!std::isfinite(total_depth) || !std::isfinite(transfer_depth) || transfer_depth>maximum_transfer_depth)
+    throw std::runtime_error("Frequent SIDM actual drag increment exceeds its frozen source-step limit");
+  pair_result result;result.relative_speed_before_kms=speed;result.optical_depth=double(total_depth*moments.small_probability);
+  if(!std::isfinite(result.optical_depth))throw std::runtime_error("Frequent SIDM recorded exposure exceeds finite double precision");
+  if(speed==0 || transfer_depth==0) {++persistent_attempt;return result;}
+  const double cosine=double(1-transfer_depth);
+  if(cosine==1)throw std::runtime_error("Frequent SIDM drag below finite rotation precision; no source update was fabricated");
+  const double phi=6.283185307179586476925286766559*
+      pair_uniform(parameters.operator_seed,left.id,right.id,integer_interval,parameters.random_substep,8,parameters.random_stage);
+  result=commit_pair_rotation(left,right,parameters,cosine,phi,native_time,scale_factor,
+      logging_rank,persistent_update_sequence,log);
+  result.optical_depth=double(total_depth*moments.small_probability);
+  ++persistent_attempt;
+  return result;
+}
+}
+#endif
diff --git a/shipped/src/sidm/research_hybrid_pair.h b/shipped/src/sidm/research_hybrid_pair.h
new file mode 100644
index 0000000..12dedbe
--- /dev/null
+++ b/shipped/src/sidm/research_hybrid_pair.h
@@ -0,0 +1,54 @@
+/* Directed hybrid source: half small-angle drag/diffusion, full sampled
+ * large-angle source, half small-angle drag/diffusion. Both channels derive
+ * from the same total cross section and angular distribution; no channel is
+ * independently normalized to the full cross section. The splitting and
+ * finite-small-angle errors require independent controls.
+ */
+#ifndef RESEARCH_HYBRID_SIDM_PAIR_H
+#define RESEARCH_HYBRID_SIDM_PAIR_H
+#include "research_frequent_pair.h"
+
+namespace research_sidm {
+struct hybrid_pair_result
+{
+  pair_result aggregate;
+  bool rare_scattered=false;
+  unsigned frequent_updates=0;
+};
+inline hybrid_pair_result apply_hybrid_pair(pair_particle &left,pair_particle &right,const rare_parameters &parameters,
+                                          double split_angle,double maximum_transfer_depth,double maximum_moment_ratio,
+                                          std::uint64_t integer_interval,std::uint64_t &persistent_attempt,
+                                          double native_time,double scale_factor,std::uint32_t logging_rank,
+                                          std::uint64_t &persistent_update_sequence,
+                                          research_sidm_event_log *rare_log,research_sidm_event_log *frequent_log)
+{
+  if(!std::isfinite(split_angle) || split_angle<=0 || split_angle>=3.1415926535897932384626433832795)
+    throw std::runtime_error("Hybrid SIDM requires a nonempty small/large-angle partition");
+  if(!rare_log || !frequent_log || rare_log==frequent_log)
+    throw std::runtime_error("Hybrid SIDM requires separate native rare and effective diffusion records");
+  // Each frequent half checks its current angular moments and approximation
+  // domain. Avoid an unconditional table query for zero-speed/disabled pairs.
+  rare_parameters half=parameters;
+  half.physical_dt_seconds=parameters.physical_dt_seconds/2;
+  require_positive(half.physical_dt_seconds,"Hybrid SIDM half source interval below finite time precision");
+  hybrid_pair_result result;
+  const auto first=apply_frequent_pair(left,right,half,split_angle,maximum_transfer_depth,maximum_moment_ratio,
+      integer_interval,persistent_attempt,native_time,scale_factor,logging_rank,persistent_update_sequence,frequent_log);
+  const auto rare=apply_rare_pair(left,right,parameters,integer_interval,persistent_attempt,
+      native_time,scale_factor,logging_rank,persistent_update_sequence,rare_log,split_angle);
+  half.random_stage=parameters.random_stage+1;
+  const auto second=apply_frequent_pair(left,right,half,split_angle,maximum_transfer_depth,maximum_moment_ratio,
+      integer_interval,persistent_attempt,native_time,scale_factor,logging_rank,persistent_update_sequence,frequent_log);
+  result.rare_scattered=rare.scattered;
+  result.frequent_updates=unsigned(first.scattered)+unsigned(second.scattered);
+  result.aggregate.scattered=rare.scattered || result.frequent_updates;
+  result.aggregate.optical_depth=first.optical_depth+rare.optical_depth+second.optical_depth;
+  result.aggregate.event_probability=rare.event_probability;
+  result.aggregate.relative_speed_before_kms=first.relative_speed_before_kms;
+  result.aggregate.relative_speed_after_kms=second.scattered?second.relative_speed_after_kms:
+      rare.scattered?rare.relative_speed_after_kms:first.scattered?first.relative_speed_after_kms:first.relative_speed_before_kms;
+  if(!std::isfinite(result.aggregate.optical_depth))throw std::runtime_error("Hybrid SIDM measured channel exposure overflow");
+  return result;
+}
+}
+#endif
diff --git a/shipped/src/sidm/research_kernel_overlap.h b/shipped/src/sidm/research_kernel_overlap.h
new file mode 100644
index 0000000..bd5d5ad
--- /dev/null
+++ b/shipped/src/sidm/research_kernel_overlap.h
@@ -0,0 +1,141 @@
+/* First-party compact SIDM kernel convolution in physical units.
+ * g_ij = integral W_i(x) W_j(x-r_ij) d^3x, units cm^-3.
+ * Cubic spline support radius H: W=8/(pi H^3) f(r/H),
+ * f(q)=1-6q^2+6q^3 below 1/2; 2(1-q)^3 up to 1.
+ * Piecewise polynomial radial convolution uses Gauss-Legendre rules exact
+ * for each polynomial segment in real arithmetic (no sampled lookup table).
+ * Reference: Rocha et al. 2013, MNRAS 430, 81; TangoSIDM appendix A.
+ */
+#ifndef RESEARCH_SIDM_KERNEL_OVERLAP_H
+#define RESEARCH_SIDM_KERNEL_OVERLAP_H
+#include <algorithm>
+#include <cmath>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace research_sidm {
+namespace kernel_detail {
+constexpr long double pi=3.141592653589793238462643383279502884L;
+inline long double spline(long double q)
+{
+  if(q<0 || q>=1)return 0;
+  if(q<.5L)return 1+q*q*(-6+6*q);
+  const long double t=1-q;
+  return 2*t*t*t;
+}
+template<class Function>
+inline long double gauss8(Function function,long double left,long double right)
+{
+  static const long double nodes[4]={.183434642495649804939476142360184L,
+    .525532409916328985817739049189246L,.796666477413626739591553936475831L,
+    .960289856497536231683560868569473L};
+  static const long double weights[4]={.362683783378361982965150449277195L,
+    .313706645877887287337962201986601L,.222381034453374470544355994426240L,
+    .101228536290376259152531354309962L};
+  const long double half=(right-left)/2,center=left+half;
+  long double sum=0;
+  for(int i=0;i<4;i++)sum+=weights[i]*(function(center-half*nodes[i])+function(center+half*nodes[i]));
+  return half*sum;
+}
+inline long double radial_primitive_difference(long double left,long double right,long double support)
+{
+  left=std::max(0.L,left);right=std::min(support,right);
+  if(right<=left)return 0;
+  // Integrate s f(s/H) without subtracting nearly equal fifth-degree
+  // antiderivatives. Three-point Gauss integrates this degree-four polynomial.
+  const long double split=support/2;
+  const auto segment=[support](long double lo,long double hi) {
+    const long double half=(hi-lo)/2,center=lo+half;
+    const long double offset=half*.774596669241483377035853079956480L;
+    const auto value=[support](long double s){return s*spline(s/support);};
+    return half*((5.L/9)*(value(center-offset)+value(center+offset))+(8.L/9)*value(center));
+  };
+  if(left<split && right>split)return segment(left,split)+segment(split,right);
+  return segment(left,right);
+}
+inline long double coincident(long double a,long double b)
+{
+  std::vector<long double> edges={0,std::min(a,b)};
+  for(long double q:{a/2,b/2})if(q>0 && q<edges[1])edges.push_back(q);
+  std::sort(edges.begin(),edges.end());
+  long double sum=0;
+  for(std::size_t i=1;i<edges.size();i++)sum+=gauss8([a,b](long double r) {
+    return r*r*spline(r/a)*spline(r/b);
+  },edges[i-1],edges[i]);
+  return 256*sum/(pi*a*a*a*b*b*b);
+}
+}
+
+inline double uniform_ball_kernel_overlap(double distance_cm,double left_radius_cm,double right_radius_cm)
+{
+  for(double value:{left_radius_cm,right_radius_cm})if(!std::isfinite(value) || value<=0)
+    throw std::runtime_error("SIDM uniform kernel support must be finite and positive");
+  if(!std::isfinite(distance_cm) || distance_cm<0)throw std::runtime_error("SIDM physical pair separation invalid");
+  const long double scale=std::max(left_radius_cm,right_radius_cm);
+  const long double a=left_radius_cm/scale,b=right_radius_cm/scale,d=distance_cm/scale;
+  if(d>=a+b)return 0;
+  long double volume;
+  if(d<=std::abs(a-b))volume=(4*kernel_detail::pi/3)*std::pow(std::min(a,b),3);
+  else {
+    const long double sum=a+b,difference=a-b;
+    volume=kernel_detail::pi*(sum-d)*(sum-d)*(d*d+2*d*sum-3*difference*difference)/(12*d);
+  }
+  const long double normalization=(4*kernel_detail::pi/3)*(4*kernel_detail::pi/3)*a*a*a*b*b*b;
+  const long double result=(volume/normalization)/scale/scale/scale;
+  if(!std::isfinite(result) || result<0 || result>std::numeric_limits<double>::max())
+    throw std::runtime_error("SIDM uniform kernel convolution outside finite physical domain");
+  return double(result);
+}
+
+inline double cubic_spline_kernel_overlap(double distance_cm,double left_radius_cm,double right_radius_cm,
+                                         double near_origin_relative_bound)
+{
+  for(double value:{left_radius_cm,right_radius_cm,near_origin_relative_bound})
+    if(!std::isfinite(value) || value<=0)throw std::runtime_error("SIDM cubic kernel support/error bound invalid");
+  if(near_origin_relative_bound>=1 || !std::isfinite(distance_cm) || distance_cm<0)
+    throw std::runtime_error("SIDM cubic kernel physical domain invalid");
+  const long double scale=std::max(left_radius_cm,right_radius_cm);
+  const long double a=left_radius_cm/scale,b=right_radius_cm/scale,d=distance_cm/scale;
+  if(d>=a+b)return 0;
+  if(std::min(a,b)<1.e-6L)
+    throw std::runtime_error("SIDM cubic kernel support ratio outside declared finite arithmetic domain");
+  long double dimensionless=0;
+  if(d==0)dimensionless=kernel_detail::coincident(a,b);
+  else if(d<1.e-8L) {
+    const long double origin=kernel_detail::coincident(a,b);
+    // Translation bound using integral W_i=1 and max |grad W_j|.
+    // Choose the larger support for the tighter bound; f' has magnitude <=2.
+    const long double lipschitz=16*d/(kernel_detail::pi*std::pow(std::max(a,b),4));
+    if(lipschitz<=near_origin_relative_bound*origin)dimensionless=origin;
+    else if(d<128*std::numeric_limits<long double>::epsilon())
+      throw std::runtime_error("SIDM kernel translation below finite precision with requested origin bound unmet");
+  }
+  if(dimensionless==0) {
+    std::vector<long double> edges={0,a};
+    // Split at every knot of f(r/a), the absolute lower limit, and both
+    // primitive limits crossing b/2 or b. The remaining integrand is polynomial.
+    for(long double q:{a/2,d,b-d,b/2-d,d-b/2,d-b,d+b/2,d+b})
+      if(q>0 && q<a)edges.push_back(q);
+    std::sort(edges.begin(),edges.end());
+    edges.erase(std::unique(edges.begin(),edges.end()),edges.end());
+    long double sum=0;
+    for(std::size_t i=1;i<edges.size();i++)sum+=kernel_detail::gauss8([a,b,d](long double r) {
+      return r*kernel_detail::spline(r/a)*kernel_detail::radial_primitive_difference(std::abs(r-d),r+d,b);
+    },edges[i-1],edges[i]);
+    dimensionless=128*sum/(kernel_detail::pi*d*a*a*a*b*b*b);
+  }
+  const long double result=dimensionless/scale/scale/scale;
+  if(!std::isfinite(result) || result<0 || result>std::numeric_limits<double>::max())
+    throw std::runtime_error("SIDM cubic kernel convolution outside finite physical domain");
+  return double(result);
+}
+inline double measured_kernel_overlap(int kind,double distance_cm,double left_radius_cm,double right_radius_cm,
+                                      double near_origin_relative_bound)
+{
+  if(kind==0)return uniform_ball_kernel_overlap(distance_cm,left_radius_cm,right_radius_cm);
+  if(kind==1)return cubic_spline_kernel_overlap(distance_cm,left_radius_cm,right_radius_cm,near_origin_relative_bound);
+  throw std::runtime_error("SIDM native kernel kind must be uniform ball (0) or cubic spline (1)");
+}
+}
+#endif
diff --git a/shipped/src/sidm/research_moller_transport.h b/shipped/src/sidm/research_moller_transport.h
new file mode 100644
index 0000000..f016de1
--- /dev/null
+++ b/shipped/src/sidm/research_moller_transport.h
@@ -0,0 +1,109 @@
+/* Unpolarized identical spin-1/2 Born Yukawa scattering, including exchange
+ * interference. Yang & Yu 2205.03392 equations 2-3; Arido et al. 2410.07175.
+ * sigma0 denotes the Rutherford low-velocity total normalization. The Moller
+ * total tends to sigma0/2, with the identical-final-state factor included once.
+ * Folded u=|cos(theta)| removes the unobservable exchange of final-state labels.
+ */
+#ifndef RESEARCH_SIDM_MOLLER_TRANSPORT_H
+#define RESEARCH_SIDM_MOLLER_TRANSPORT_H
+#include "research_folded_transport.h"
+namespace research_sidm {
+inline long double moller_parameter(double speed,double scale)
+{
+  if(!std::isfinite(speed) || speed<0 || !std::isfinite(scale) || scale<=0)
+    throw std::runtime_error("Born Moller velocity domain invalid");
+  const long double ratio=static_cast<long double>(speed)/scale,a=ratio*ratio/2;
+  if(!std::isfinite(a) || !std::isfinite(a*a))throw std::runtime_error("Born Moller anisotropy exceeds finite domain");
+  return a;
+}
+inline long double moller_primitive(long double u,long double a)
+{
+  if(u<0 || u>1)throw std::runtime_error("Born Moller folded cosine invalid");
+  if(a==0)return u/2;
+  const long double c=1+a,plus=1+a*(1-u),minus=1+a*(1+u);
+  // log1p form avoids subtracting nearly equal logarithms near isotropy/u=0.
+  const long double interference=std::log1p(2*a*u/plus)/(4*a*c);
+  const long double result=u/(plus*minus)-interference;
+  if(!std::isfinite(result) || result<0)throw std::runtime_error("Born Moller primitive lost positive support");
+  return result;
+}
+inline double moller_total_factor(double speed,double scale)
+{return double(moller_primitive(1,moller_parameter(speed,scale)));}
+inline long double moller_cumulative(long double u,long double a)
+{return moller_primitive(u,a)/moller_primitive(1,a);}
+
+inline long double moller_simple_power(int power,long double a,long double limit,bool reverse,long double tolerance)
+{
+  if(limit==0)return 0;
+  const long double denominator=reverse?1+2*a:1;
+  const long double ratio=(reverse?a/denominator:-a)*limit;
+  if(reverse || std::abs(ratio)<.25L) {
+    long double sum=0,scale=1;
+    const long double factor=std::pow(limit,power+1)/denominator;
+    for(int order=0;order<256;++order) {
+      sum+=scale/(power+order+1);
+      const long double next=std::abs(scale*ratio)/(power+order+2);
+      if(std::abs(ratio)<1 && factor*next/(1-std::abs(ratio))<=tolerance/8)return factor*sum;
+      scale*=ratio;
+    }
+    throw std::runtime_error("Born Moller interference moment exhausted bounded series");
+  }
+  long double value=std::log1p(a*limit)/a;
+  for(int n=1;n<=power;++n)value=std::pow(limit,n)/(a*n)-value/a;
+  const long double allowance=512*std::numeric_limits<long double>::epsilon()*
+      (1+std::pow(limit,power+1))*(1+1/a+1/(a*a*a));
+  if(!std::isfinite(value) || value<0 || allowance>tolerance)
+    throw std::runtime_error("Born Moller interference moment cannot meet requested precision");
+  return value;
+}
+inline angular_transport_moments moller_angular_transport(double speed,double scale,double angle,double tolerance)
+{
+  folded_angular_transport(true,speed,scale,angle,tolerance);
+  const long double a=moller_parameter(speed,scale),total=moller_primitive(1,a);
+  const long double sine=std::sin(static_cast<long double>(angle)/2),cutoff=2*sine*sine;
+  const auto moment=[&](int power,long double limit) {
+    const long double precision=tolerance*total/16;
+    const long double interference=(moller_simple_power(power,a,limit,false,precision)+
+        moller_simple_power(power,a,limit,true,precision))/(2*(1+a));
+    long double direct;
+    if(power==0)direct=limit/(2*(1+a*limit))+limit/(2*(1+2*a-a*limit));
+    else direct=(angular_power_integral(power,a,limit,precision)+
+        folded_reverse_power_integral(power,a,limit,precision))/(1+2*a);
+    const long double result=(direct-interference/2)/total;
+    if(!std::isfinite(result) || result<0)throw std::runtime_error("Born Moller moment lost nonnegative support");
+    return double(result);
+  };
+  angular_transport_moments result;
+  result.small_probability=moment(0,cutoff);
+  result.large_probability=double(moller_cumulative(1-cutoff,a));
+  result.small_transfer=moment(1,cutoff);result.small_second_moment=moment(2,cutoff);
+  result.full_transfer=moment(1,1);result.full_second_moment=moment(2,1);
+  result.small_viscosity=2*result.small_transfer-result.small_second_moment;
+  result.full_viscosity=2*result.full_transfer-result.full_second_moment;
+  result.neglected_moment_ratio=result.small_transfer?result.small_second_moment/result.small_transfer:0;
+  for(double value:{result.small_probability,result.large_probability,result.small_transfer,result.small_second_moment,
+      result.full_transfer,result.full_second_moment,result.small_viscosity,result.full_viscosity,result.neglected_moment_ratio})
+    if(!std::isfinite(value) || value<0)throw std::runtime_error("Born Moller transport outside physical precision domain");
+  return result;
+}
+inline double moller_large_angle_cosine(double quantile,double speed,double scale,double angle,double tolerance)
+{
+  if(!std::isfinite(quantile) || quantile<=0 || quantile>=1)
+    throw std::runtime_error("Born Moller quantile must be strictly inside (0,1)");
+  if(!std::isfinite(angle) || angle<0 || angle>1.57079632679489661923 || !std::isfinite(tolerance) || tolerance<=0)
+    throw std::runtime_error("Born Moller inverse CDF domain invalid");
+  const long double a=moller_parameter(speed,scale),maximum=std::cos(static_cast<long double>(angle));
+  const long double mass=moller_primitive(maximum,a);
+  if(mass<=0)throw std::runtime_error("Born Moller large-angle distribution has empty support");
+  long double low=0,high=maximum;
+  for(int iteration=0;iteration<128;++iteration) {
+    const long double middle=(low+high)/2;
+    const long double recovered=moller_primitive(middle,a)/mass;
+    if(recovered<quantile)low=middle;else high=middle;
+    const double retained=double(middle);
+    if(std::abs(moller_primitive(retained,a)/mass-quantile)<=tolerance)return retained;
+  }
+  throw std::runtime_error("Born Moller retained inverse CDF exhausted bounded precision/work");
+}
+}
+#endif
diff --git a/shipped/src/sidm/research_pair_exchange.h b/shipped/src/sidm/research_pair_exchange.h
new file mode 100644
index 0000000..eaf50ac
--- /dev/null
+++ b/shipped/src/sidm/research_pair_exchange.h
@@ -0,0 +1,228 @@
+/* First-party bounded distributed SIDM pair scheduling.
+ * Endpoint owners select their smallest pending canonical pair. Only mutual
+ * choices execute, so no particle receives concurrent pair updates. Current
+ * physical endpoint states are supplied by their actual owners each round.
+ * Neighbor discovery belongs to the spatial producer, not this scheduler.
+ * MPI wire records require the same native binary/ABI across communicator.
+ */
+#ifndef RESEARCH_SIDM_PAIR_EXCHANGE_H
+#define RESEARCH_SIDM_PAIR_EXCHANGE_H
+#include "research_rare_pair.h"
+#include <mpi.h>
+#include <climits>
+#include <map>
+#include <set>
+#include <tuple>
+#include <type_traits>
+#include <vector>
+
+namespace research_sidm {
+struct pair_exchange_limits
+{
+  std::uint64_t maximum_local_pairs,maximum_rounds,maximum_exchange_records,memory_bytes;
+};
+struct distributed_pair
+{
+  std::uint64_t left_id,right_id;
+  int left_owner,right_owner;
+  double kernel_overlap_inverse_cm3;
+  double left_mass_msun,right_mass_msun;
+  int left_type,right_type;
+};
+struct distributed_pair_effect
+{
+  pair_particle left,right;
+  double optical_depth=0;
+  std::uint64_t rare_events=0,frequent_updates=0;
+};
+struct pair_exchange_measurements
+{
+  std::uint64_t matching_rounds=0,completed_local_pairs=0,remote_endpoint_updates=0;
+  std::uint64_t sent_bytes=0,received_bytes=0,buffer_payload_peak_bytes=0;
+};
+inline void require_collective(MPI_Comm communicator,bool local_condition,const char *message)
+{
+  int local=local_condition?1:0,global=0;
+  if(MPI_Allreduce(&local,&global,1,MPI_INT,MPI_MIN,communicator)!=MPI_SUCCESS)
+    throw std::runtime_error("SIDM collective domain agreement failed");
+  if(!global)throw std::runtime_error(message);
+}
+template<class Record> struct received_pair_records
+{
+  std::vector<Record> values;
+  std::vector<int> origins;
+};
+template<class Record>
+received_pair_records<Record> exchange_pair_records(MPI_Comm communicator,const std::vector<std::pair<int,Record>> &outgoing,
+                                                    const pair_exchange_limits &limits,pair_exchange_measurements &measurements)
+{
+  static_assert(std::is_trivially_copyable<Record>::value,"SIDM MPI records must contain no owning pointers");
+  int ranks=0;MPI_Comm_size(communicator,&ranks);
+  bool valid=ranks>0 && outgoing.size()<=limits.maximum_exchange_records &&
+      outgoing.size()<=std::size_t(INT_MAX)/sizeof(Record) &&
+      limits.memory_bytes/8>=outgoing.size()*sizeof(Record)+std::uint64_t(ranks)*sizeof(int)*4;
+  for(const auto &row:outgoing)valid=valid && row.first>=0 && row.first<ranks;
+  require_collective(communicator,valid,"SIDM outgoing exchange exceeds declared rank, record or workspace bounds");
+  std::vector<int> send_counts(ranks,0),receive_counts(ranks,0),send_offsets(ranks,0),receive_offsets(ranks,0);
+  for(const auto &row:outgoing)send_counts[row.first]+=sizeof(Record);
+  if(MPI_Alltoall(send_counts.data(),1,MPI_INT,receive_counts.data(),1,MPI_INT,communicator)!=MPI_SUCCESS)
+    throw std::runtime_error("SIDM pair exchange census failed");
+  std::uint64_t sent=0,received=0;
+  valid=true;
+  for(int rank=0;rank<ranks;rank++) {
+    valid=valid && receive_counts[rank]>=0 && receive_counts[rank]%sizeof(Record)==0;
+    if(sent<=INT_MAX)send_offsets[rank]=int(sent);else valid=false;
+    if(received<=INT_MAX)receive_offsets[rank]=int(received);else valid=false;
+    sent+=send_counts[rank];received+=std::uint64_t(std::max(0,receive_counts[rank]));
+  }
+  valid=valid && sent<=INT_MAX && received<=INT_MAX && received/sizeof(Record)<=limits.maximum_exchange_records &&
+      limits.memory_bytes/8>=sent+received+std::uint64_t(ranks)*sizeof(int)*4;
+  require_collective(communicator,valid,"SIDM incoming exchange exceeds its frozen record or memory allocation");
+  std::vector<Record> packed(sent/sizeof(Record));
+  std::vector<int> cursors=send_offsets;
+  for(const auto &row:outgoing) {packed[cursors[row.first]/sizeof(Record)]=row.second;cursors[row.first]+=sizeof(Record);}
+  received_pair_records<Record> result;
+  result.values.resize(received/sizeof(Record));result.origins.resize(result.values.size());
+  // Actual vector capacity payload retained together at the exchange boundary;
+  // excludes allocator headers, maps, MPI-private buffers and caller workspaces.
+  const std::uint64_t buffer_payload=std::uint64_t(outgoing.capacity())*sizeof(std::pair<int,Record>)+
+      std::uint64_t(packed.capacity()+result.values.capacity())*sizeof(Record)+
+      std::uint64_t(result.origins.capacity()+send_counts.capacity()+receive_counts.capacity()+
+          send_offsets.capacity()+receive_offsets.capacity()+cursors.capacity())*sizeof(int);
+  measurements.buffer_payload_peak_bytes=std::max(measurements.buffer_payload_peak_bytes,buffer_payload);
+  if(MPI_Alltoallv(packed.data(),send_counts.data(),send_offsets.data(),MPI_BYTE,result.values.data(),
+      receive_counts.data(),receive_offsets.data(),MPI_BYTE,communicator)!=MPI_SUCCESS)
+    throw std::runtime_error("SIDM bounded pair record exchange failed");
+  for(int rank=0;rank<ranks;rank++)for(std::size_t index=receive_offsets[rank]/sizeof(Record);
+      index<std::size_t(receive_offsets[rank]+receive_counts[rank])/sizeof(Record);index++)result.origins[index]=rank;
+  require_collective(communicator,sent<=UINT64_MAX-measurements.sent_bytes && received<=UINT64_MAX-measurements.received_bytes,
+      "SIDM pair exchange telemetry counter exhausted");
+  measurements.sent_bytes+=sent;measurements.received_bytes+=received;
+  return result;
+}
+inline std::uint64_t distributed_pair_attempt_key(std::uint64_t left,std::uint64_t right,std::uint64_t source_substep)
+{
+  return mix(left)^mix(right+UINT64_C(0x2718281828459045))^mix(source_substep);
+}
+
+template<class ReadOwner,class ApplyPair,class CommitOwner>
+pair_exchange_measurements execute_distributed_pairs(MPI_Comm communicator,const std::vector<distributed_pair> &pairs,
+                                                     const pair_exchange_limits &limits,ReadOwner read_owner,
+                                                     ApplyPair apply_pair,CommitOwner commit_owner,
+                                                     std::uint64_t seed=0,std::uint64_t interval=0,std::uint64_t substep=0)
+{
+  int ranks=0,rank=0;MPI_Comm_size(communicator,&ranks);MPI_Comm_rank(communicator,&rank);
+  pair_exchange_measurements measurements;
+  bool valid=limits.maximum_rounds>0 && limits.maximum_exchange_records>0 &&
+      pairs.size()<=limits.maximum_local_pairs && limits.memory_bytes/256>=pairs.size();
+  for(const auto &pair:pairs)valid=valid && pair.left_id<pair.right_id && pair.left_owner>=0 && pair.left_owner<ranks &&
+      pair.right_owner>=0 && pair.right_owner<ranks && std::isfinite(pair.kernel_overlap_inverse_cm3) && pair.kernel_overlap_inverse_cm3>0;
+  require_collective(communicator,valid,"SIDM distributed pair matrix changes canonical identity, owner or allocation");
+  // Establish exactly one worker per unordered pair before applying updates.
+  struct identity_record {std::uint64_t left,right;};
+  {
+  std::vector<std::pair<int,identity_record>> identities;
+  identities.reserve(pairs.size());
+  for(const auto &pair:pairs)identities.push_back({int((mix(pair.left_id)^mix(pair.right_id))%std::uint64_t(ranks)),
+      {pair.left_id,pair.right_id}});
+  const auto directory=exchange_pair_records(communicator,identities,limits,measurements);
+  std::set<std::pair<std::uint64_t,std::uint64_t>> unique;
+  valid=true;for(const auto &identity:directory.values)valid=unique.insert({identity.left,identity.right}).second && valid;
+  require_collective(communicator,valid,"SIDM unordered pair is duplicated across native work ranks");
+  }
+  std::vector<unsigned char> completed(pairs.size(),0);
+  struct proposal {std::uint64_t particle,left,right,index,priority;int worker;};
+  struct response {std::uint64_t index,particle;int selected;pair_particle state;};
+  struct mutation {std::uint64_t particle,left,right,index,rare_events,frequent_updates;int worker;
+                   pair_particle state;double optical_depth;};
+  for(std::uint64_t round=0;;round++) {
+    int local_pending=std::find(completed.begin(),completed.end(),0)!=completed.end(),global_pending=0;
+    if(MPI_Allreduce(&local_pending,&global_pending,1,MPI_INT,MPI_MAX,communicator)!=MPI_SUCCESS)
+      throw std::runtime_error("SIDM distributed matching progress agreement failed");
+    if(!global_pending)break;
+    require_collective(communicator,round<limits.maximum_rounds,"SIDM distributed matching round allocation exhausted");
+    std::vector<std::pair<int,proposal>> outgoing;
+    require_collective(communicator,pairs.size()<=limits.maximum_exchange_records/2,"SIDM endpoint proposals exceed exchange allocation");
+    outgoing.reserve(2*pairs.size());
+    for(std::size_t index=0;index<pairs.size();index++)if(!completed[index]) {
+      const auto &pair=pairs[index];
+      const auto priority=pair_random_bits(seed,pair.left_id,pair.right_id,interval,substep,std::uint64_t(draw_purpose::pair_priority));
+      outgoing.push_back({pair.left_owner,{pair.left_id,pair.left_id,pair.right_id,index,priority,rank}});
+      outgoing.push_back({pair.right_owner,{pair.right_id,pair.left_id,pair.right_id,index,priority,rank}});
+    }
+    const auto incoming=exchange_pair_records(communicator,outgoing,limits,measurements);
+    std::map<std::uint64_t,proposal> choices;
+    valid=true;
+    for(std::size_t index=0;index<incoming.values.size();index++) {
+      const auto &row=incoming.values[index];
+      valid=valid && row.worker==incoming.origins[index] && row.left<row.right && (row.particle==row.left || row.particle==row.right);
+      const auto old=choices.find(row.particle);
+      if(old==choices.end() || std::tie(row.priority,row.left,row.right)<std::tie(old->second.priority,old->second.left,old->second.right))choices[row.particle]=row;
+    }
+    require_collective(communicator,valid,"SIDM endpoint proposal ownership or canonical pair differs");
+    std::vector<std::pair<int,response>> replies;
+    replies.reserve(incoming.values.size());
+    for(const auto &row:incoming.values) {
+      const auto &chosen=choices.at(row.particle);
+      const bool selected=chosen.left==row.left && chosen.right==row.right;
+      pair_particle state{};
+      if(selected) {state=read_owner(row.particle);if(state.id!=row.particle)throw std::runtime_error("SIDM current endpoint is absent from its declared native owner");}
+      replies.push_back({row.worker,{row.index,row.particle,selected?1:0,state}});
+    }
+    const auto returned=exchange_pair_records(communicator,replies,limits,measurements);
+    struct selection {int left=0,right=0;pair_particle l{},r{};};
+    std::vector<selection> selections(pairs.size());
+    valid=true;
+    for(std::size_t index=0;index<returned.values.size();index++) {
+      const auto &row=returned.values[index];
+      if(row.index>=pairs.size() || completed[row.index] || (row.selected!=0 && row.selected!=1)) {valid=false;continue;}
+      const auto &pair=pairs[row.index];auto &choice=selections[row.index];
+      if(row.particle==pair.left_id && returned.origins[index]==pair.left_owner && !choice.left) {
+        choice.left=row.selected?2:1;choice.l=row.state;
+      } else if(row.particle==pair.right_id && returned.origins[index]==pair.right_owner && !choice.right) {
+        choice.right=row.selected?2:1;choice.r=row.state;
+      } else valid=false;
+    }
+    for(std::size_t index=0;index<pairs.size();index++)if(!completed[index])valid=valid && selections[index].left && selections[index].right;
+    require_collective(communicator,valid,"SIDM current endpoint response is duplicated, missing or supplied by another owner");
+    std::vector<std::pair<int,mutation>> updates;
+    std::vector<std::size_t> accepted;
+    for(std::size_t index=0;index<pairs.size();index++)if(!completed[index] && selections[index].left==2 && selections[index].right==2) {
+      const auto &pair=pairs[index];const auto &selection=selections[index];
+      auto effect=apply_pair(pair,selection.l,selection.r);
+      if(effect.left.id!=pair.left_id || effect.right.id!=pair.right_id || effect.left.mass_msun!=selection.l.mass_msun ||
+          effect.right.mass_msun!=selection.r.mass_msun || !std::isfinite(effect.optical_depth) || effect.optical_depth<0 ||
+          effect.rare_events>1 || effect.frequent_updates>2)
+        throw std::runtime_error("SIDM applied pair changes native identity/mass or supplies invalid exposure");
+      updates.push_back({pair.left_owner,{pair.left_id,pair.left_id,pair.right_id,index,effect.rare_events,effect.frequent_updates,
+          rank,effect.left,effect.optical_depth}});
+      updates.push_back({pair.right_owner,{pair.right_id,pair.left_id,pair.right_id,index,effect.rare_events,effect.frequent_updates,
+          rank,effect.right,effect.optical_depth}});
+      accepted.push_back(index);
+    }
+    const auto commits=exchange_pair_records(communicator,updates,limits,measurements);
+    std::set<std::uint64_t> touched;
+    valid=true;
+    for(std::size_t index=0;index<commits.values.size();index++) {
+      const auto &row=commits.values[index];const auto choice=choices.find(row.particle);
+      valid=valid && touched.insert(row.particle).second && row.worker==commits.origins[index] && choice!=choices.end();
+      if(choice!=choices.end())valid=valid && row.worker==choice->second.worker && row.index==choice->second.index &&
+          row.left==choice->second.left && row.right==choice->second.right && row.state.id==row.particle;
+      for(double velocity:row.state.velocity_kms)valid=valid && std::isfinite(velocity);
+    }
+    require_collective(communicator,valid,"SIDM simultaneous native commits conflict or differ from mutually chosen pairs");
+    for(const auto &row:commits.values) {
+      commit_owner(row.state,row.optical_depth,row.rare_events,row.frequent_updates);
+      if(row.worker!=rank)++measurements.remote_endpoint_updates;
+    }
+    for(std::size_t index:accepted)completed[index]=1;
+    measurements.completed_local_pairs+=accepted.size();++measurements.matching_rounds;
+    int local_progress=!accepted.empty(),global_progress=0;
+    if(MPI_Allreduce(&local_progress,&global_progress,1,MPI_INT,MPI_MAX,communicator)!=MPI_SUCCESS)
+      throw std::runtime_error("SIDM pair commit progress reduction failed");
+    if(!global_progress)throw std::runtime_error("SIDM distributed canonical matching made no progress");
+  }
+  return measurements;
+}
+}
+#endif
