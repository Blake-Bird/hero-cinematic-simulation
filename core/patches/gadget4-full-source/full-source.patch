index 0000000..983c66d
--- /dev/null
+++ b/shipped/third_party/random123/tests/time_serial.c
@@ -0,0 +1,162 @@
+/*
+Copyright 2010-2011, D. E. Shaw Research.
+All rights reserved.
+
