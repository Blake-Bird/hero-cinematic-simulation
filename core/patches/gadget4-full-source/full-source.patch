+  MPI_Allreduce(keys.data(),keys_low.data(),3,MPI_UNSIGNED_LONG_LONG,MPI_MIN,comm);MPI_Allreduce(keys.data(),keys_high.data(),3,MPI_UNSIGNED_LONG_LONG,MPI_MAX,comm);
