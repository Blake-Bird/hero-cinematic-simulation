+  const double fraction = (log(a) - log(CosmologyTableA[lo])) / (log(CosmologyTableA[hi]) - log(CosmologyTableA[lo]));
+  return exp(log(values[lo]) + fraction * (log(values[hi]) - log(values[lo])));
