+              All.SIDMReferenceAttemptCount,event_native_time,scale_factor,0,All.SIDMReferenceEventCount,&log);
+        frequent_updates=unsigned(result.scattered);
+      } else {
+        const auto hybrid=research_sidm::apply_hybrid_pair(particles[left].value,particles[right].value,parameters,
+            All.SIDMReferenceSplitAngleRadians,All.SIDMReferenceMaximumTransferDepth,All.SIDMReferenceMaximumNeglectedMomentRatio,
+            std::uint64_t(All.Ti_Current),All.SIDMReferenceAttemptCount,event_native_time,scale_factor,0,All.SIDMReferenceEventCount,
+            &log,diffusion_log.get());
+        result=hybrid.aggregate;rare_scattered=hybrid.rare_scattered;frequent_updates=hybrid.frequent_updates;
+      }
+      All.SIDMReferenceOpticalDepthSum+=result.optical_depth;
+      if(!std::isfinite(All.SIDMReferenceOpticalDepthSum))Terminate("SIDM reference exposure accumulator overflow");
+      for(std::size_t index:{left,right}) {
+        auto &source=Sp.P[particles[index].native_index].ResearchSourceState;
+        source.sidm_optical_depth+=result.optical_depth;
+        source.sidm_random_counter=All.SIDMReferenceSubstepCount;
+        if(!std::isfinite(source.sidm_optical_depth))Terminate("SIDM native particle exposure accumulator overflow");
+      }
+      if(result.scattered) {
+        if(frequent_updates) {
+          if(frequent_updates>std::numeric_limits<std::uint64_t>::max()-All.SIDMReferenceFrequentUpdateCount)
+            Terminate("SIDM frequent source update counter exhausted");
+          All.SIDMReferenceFrequentUpdateCount+=frequent_updates;
+        }
+        for(std::size_t index:{left,right}) {
+          auto &native=Sp.P[particles[index].native_index];
+          for(int k=0;k<3;k++)native.Vel[k]=particles[index].value.velocity_kms[k]/velocity_unit;
+          native.ResearchSourceState.sidm_last_update_time=All.Time;
+          if(rare_scattered) {
+            if(native.ResearchSourceState.sidm_collision_count==std::numeric_limits<std::uint64_t>::max())Terminate("SIDM particle collision counter exhausted");
+            native.ResearchSourceState.sidm_collision_count++;
+          }
+          native.ResearchSourceState.sidm_random_counter=All.SIDMReferenceSubstepCount;
+        }
+      }
+    }
+      elapsed=next_elapsed;
+#ifdef RESEARCH_SIDM_CANONICAL_CONTROL
+      source_begin_scale=source_end_scale;
+      source_begin_bracket=source_end_bracket;
+#endif
+      ++substeps;
+      if(All.SIDMReferenceSubstepCount==std::numeric_limits<std::uint64_t>::max())
+        Terminate("SIDM persistent source-substep counter exhausted");
+      ++All.SIDMReferenceSubstepCount;
+      if(All.SIDMReferenceSmallestSourceStepSeconds==0 || step_seconds<All.SIDMReferenceSmallestSourceStepSeconds)
+        All.SIDMReferenceSmallestSourceStepSeconds=step_seconds;
+    }
+    if(visits>std::numeric_limits<std::uint64_t>::max()-All.SIDMReferencePairVisitCount)
+      Terminate("SIDM persistent source-work counter exhausted");
+    All.SIDMReferencePairVisitCount+=visits;
+    log.record_source_interval(interval_seconds,std::uint64_t(substeps),visits,smallest_step,
+        All.SIDMReferenceMaximumEventProbability,All.SIDMReferenceMaximumParticleProbability,
+        All.SIDMReferenceKernelKind,All.SIDMReferenceKernelRadiusProperKpc);
+    if(diffusion_log)diffusion_log->record_source_interval(interval_seconds,std::uint64_t(substeps),visits,smallest_step,
+        All.SIDMReferenceMaximumEventProbability,All.SIDMReferenceMaximumParticleProbability,
+        All.SIDMReferenceKernelKind,All.SIDMReferenceKernelRadiusProperKpc);
+    log.record_largest_source_step(largest_step);
+    if(diffusion_log)diffusion_log->record_largest_source_step(largest_step);
+#ifdef RESEARCH_SIDM_CANONICAL_CONTROL
+    log.record_canonical_substep_clock(source_clock_work,largest_scale_span,substep_clock_error,substep_inverse_bracket);
+    if(diffusion_log)diffusion_log->record_canonical_substep_clock(source_clock_work,largest_scale_span,substep_clock_error,substep_inverse_bracket);
+#endif
+    std::uint64_t measured_peak_rss=0;
+    const bool rss_available=research_sidm::process_peak_rss_bytes(measured_peak_rss);
+    const auto record_resources=[&](research_sidm_event_log &output) {
+      output.record_distributed_exchange(0,1,particles.size()>1?std::uint64_t(particles.size())*(particles.size()-1)/2:0,0,0,0,0,0,
+          completed_pair_operations,true);
+      output.record_resource_measurements(resource_measurements.cpu_available,resource_measurements.pair_cpu_seconds,
+          resource_measurements.rare_cpu_seconds,resource_measurements.frequent_cpu_seconds,
+          resource_measurements.rare_calls,resource_measurements.frequent_calls,rss_available,measured_peak_rss,0,research_sidm::native_differential_model()?research_sidm::native_differential_model()->memory_bytes():0);
+    };
+    record_resources(log);if(diffusion_log)record_resources(*diffusion_log);
+    log.finish();
+    if(diffusion_log)diffusion_log->finish();
+  } catch(const std::exception &error) {Terminate("SIDM reference source failure: %s",error.what());}
+}
+#endif
diff --git a/shipped/src/sidm/research_resource_measurements.h b/shipped/src/sidm/research_resource_measurements.h
new file mode 100644
index 0000000..dbd3031
--- /dev/null
+++ b/shipped/src/sidm/research_resource_measurements.h
@@ -0,0 +1,74 @@
+/* Native source resource telemetry. Measurements never change source physics. */
+#ifndef RESEARCH_SIDM_RESOURCE_MEASUREMENTS_H
+#define RESEARCH_SIDM_RESOURCE_MEASUREMENTS_H
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <sys/resource.h>
+#include <time.h>
+namespace research_sidm {
+struct source_resource_measurements
+{
+  double pair_cpu_seconds=0,rare_cpu_seconds=0,frequent_cpu_seconds=0;
+  std::uint64_t rare_calls=0,frequent_calls=0,exchange_buffer_peak_bytes=0;
+  bool cpu_available=true;
+};
+inline bool thread_cpu_now(long double &seconds)
+{
+#ifdef CLOCK_THREAD_CPUTIME_ID
+  struct timespec stamp;
+  if(clock_gettime(CLOCK_THREAD_CPUTIME_ID,&stamp)==0) {
+    seconds=static_cast<long double>(stamp.tv_sec)+stamp.tv_nsec/1.e9L;
+    return std::isfinite(seconds);
+  }
+#endif
+  return false;
+}
+class source_cpu_scope
+{
+  source_resource_measurements *measurements;
+  int channel;
+  long double begin=0;
+  bool available=false;
+public:
+  source_cpu_scope(source_resource_measurements *value,int kind):measurements(value),channel(kind)
+  {
+    if(measurements)available=thread_cpu_now(begin);
+  }
+  ~source_cpu_scope() noexcept
+  {
+    if(!measurements)return;
+    long double end=0;
+    if(!available || !thread_cpu_now(end) || end<begin) {measurements->cpu_available=false;return;}
+    const double elapsed=double(end-begin);
+    double &total=channel==0?measurements->pair_cpu_seconds:channel==1?measurements->rare_cpu_seconds:measurements->frequent_cpu_seconds;
+    if(!std::isfinite(total+elapsed)) {measurements->cpu_available=false;return;}
+    total+=elapsed;
+    if(channel) {
+      std::uint64_t &calls=channel==1?measurements->rare_calls:measurements->frequent_calls;
+      if(calls==UINT64_MAX)measurements->cpu_available=false;else ++calls;
+    }
+  }
+  source_cpu_scope(const source_cpu_scope &)=delete;
+  source_cpu_scope &operator=(const source_cpu_scope &)=delete;
+};
+inline bool process_peak_rss_bytes(std::uint64_t &bytes)
+{
+  struct rusage usage;
+  if(getrusage(RUSAGE_SELF,&usage)!=0 || usage.ru_maxrss<0)return false;
+#if defined(__linux__)
+  const std::uint64_t multiplier=1024;
+#elif defined(__APPLE__)
+  const std::uint64_t multiplier=1;
+#else
+  // POSIX does not specify the units of this field. Never guess them.
+  return false;
+#endif
+#if defined(__linux__) || defined(__APPLE__)
+  if(std::uint64_t(usage.ru_maxrss)>UINT64_MAX/multiplier)return false;
+  bytes=std::uint64_t(usage.ru_maxrss)*multiplier;
+  return true;
+#endif
+}
+}
+#endif
diff --git a/shipped/src/sidm/research_spatial_pairs.h b/shipped/src/sidm/research_spatial_pairs.h
new file mode 100644
index 0000000..fa19842
--- /dev/null
+++ b/shipped/src/sidm/research_spatial_pairs.h
@@ -0,0 +1,153 @@
+/* Distributed spatial cell ghosting for compact native SIDM pair support.
+ * A particle is sent only to its cell and adjacent cells. The worker owning
+ * the lower-ID endpoint's primary cell creates the canonical pair once.
+ * Velocity updates remain with native owners through research_pair_exchange.
+ */
+#ifndef RESEARCH_SIDM_SPATIAL_PAIRS_H
+#define RESEARCH_SIDM_SPATIAL_PAIRS_H
+#include "research_pair_exchange.h"
+#include "research_kernel_overlap.h"
+#include <array>
+
+namespace research_sidm {
+struct spatial_pair_particle
+{
+  std::uint64_t id;
+  int owner;
+  std::array<double,3> proper_position_cm;
+  double proper_support_radius_cm;
+  double mass_msun;
+  int native_type;
+};
+struct spatial_pair_products
+{
+  std::vector<distributed_pair> pairs;
+  pair_exchange_measurements exchange;
+  std::uint64_t received_ghost_records=0,examined_neighbors=0;
+};
+inline spatial_pair_products build_spatial_pairs(MPI_Comm communicator,const std::vector<spatial_pair_particle> &local,
+                                               double maximum_radius_cm,double periodic_box_cm,int kernel_kind,
+                                               double kernel_origin_bound,std::uint64_t maximum_neighbor_visits,
+                                               const pair_exchange_limits &limits)
+{
+  int ranks=0,rank=0;MPI_Comm_size(communicator,&ranks);MPI_Comm_rank(communicator,&rank);
+  bool valid=std::isfinite(maximum_radius_cm) && maximum_radius_cm>0 && std::isfinite(periodic_box_cm) &&
+      periodic_box_cm>=0 && maximum_neighbor_visits>0 && limits.memory_bytes/256>=local.size();
+  for(const auto &particle:local) {
+    valid=valid && particle.owner==rank && std::isfinite(particle.proper_support_radius_cm) &&
+        particle.proper_support_radius_cm>0 && particle.proper_support_radius_cm<=maximum_radius_cm &&
+        std::isfinite(particle.mass_msun) && particle.mass_msun>0 && (particle.native_type==1 || particle.native_type==2);
+    for(double position:particle.proper_position_cm)valid=valid && std::isfinite(position);
+  }
+  require_collective(communicator,valid,"SIDM spatial ghost input changes native owner, physical support or workspace");
+  double minimum_radius=0,maximum_radius=0,minimum_box=0,maximum_box=0;
+  MPI_Allreduce(&maximum_radius_cm,&minimum_radius,1,MPI_DOUBLE,MPI_MIN,communicator);
+  MPI_Allreduce(&maximum_radius_cm,&maximum_radius,1,MPI_DOUBLE,MPI_MAX,communicator);
+  MPI_Allreduce(&periodic_box_cm,&minimum_box,1,MPI_DOUBLE,MPI_MIN,communicator);
+  MPI_Allreduce(&periodic_box_cm,&maximum_box,1,MPI_DOUBLE,MPI_MAX,communicator);
+  require_collective(communicator,minimum_radius==maximum_radius && minimum_box==maximum_box,
+      "SIDM spatial ranks disagree about physical kernel support or periodic geometry");
+  int minimum_kind=0,maximum_kind=0;
+  double minimum_origin_bound=0,maximum_origin_bound=0;
+  MPI_Allreduce(&kernel_kind,&minimum_kind,1,MPI_INT,MPI_MIN,communicator);
+  MPI_Allreduce(&kernel_kind,&maximum_kind,1,MPI_INT,MPI_MAX,communicator);
+  MPI_Allreduce(&kernel_origin_bound,&minimum_origin_bound,1,MPI_DOUBLE,MPI_MIN,communicator);
+  MPI_Allreduce(&kernel_origin_bound,&maximum_origin_bound,1,MPI_DOUBLE,MPI_MAX,communicator);
+  require_collective(communicator,minimum_kind==maximum_kind && (kernel_kind==0 || kernel_kind==1) &&
+      std::isfinite(kernel_origin_bound) && kernel_origin_bound>0 && kernel_origin_bound<1 &&
+      minimum_origin_bound==maximum_origin_bound,"SIDM ranks disagree about the actual scattering kernel definition");
+  double width=2*maximum_radius_cm;
+  std::int64_t periodic_cells=0;
+  if(periodic_box_cm>0) {
+    const double cells=std::floor(periodic_box_cm/width);
+    require_collective(communicator,cells>=4 && cells<double(INT64_MAX/2),
+        "SIDM periodic spatial support does not fit the unique neighbor-cell domain");
+    periodic_cells=std::int64_t(cells);width=periodic_box_cm/periodic_cells;
+  }
+  spatial_pair_products result;
+  struct ghost {spatial_pair_particle particle;std::array<std::int64_t,3> primary,target;};
+  const auto worker=[ranks](const std::array<std::int64_t,3> &cell) {
+    return int((mix(std::uint64_t(cell[0]))^mix(std::uint64_t(cell[1])+UINT64_C(0x1618033988749894))^
+        mix(std::uint64_t(cell[2])+UINT64_C(0x1414213562373095)))%std::uint64_t(ranks));
+  };
+  // Establish global ID uniqueness before ghost copies can obscure ownership.
+  {
+    struct identity {std::uint64_t id;int owner;};
+    std::vector<std::pair<int,identity>> outgoing;
+    outgoing.reserve(local.size());
+    for(const auto &particle:local)outgoing.push_back({int(mix(particle.id)%std::uint64_t(ranks)),{particle.id,rank}});
+    const auto incoming=exchange_pair_records(communicator,outgoing,limits,result.exchange);
+    std::set<std::uint64_t> ids;
+    valid=true;for(std::size_t index=0;index<incoming.values.size();index++)valid=
+        ids.insert(incoming.values[index].id).second && incoming.values[index].owner==incoming.origins[index] && valid;
+    require_collective(communicator,valid,"SIDM spatial native particle identity is duplicated or has inconsistent ownership");
+  }
+  require_collective(communicator,local.size()<=limits.maximum_exchange_records/27,
+      "SIDM spatial ghost replication exceeds the recorded exchange allocation");
+  std::vector<std::pair<int,ghost>> outgoing;
+  outgoing.reserve(27*local.size());
+  for(const auto &original:local) {
+    auto particle=original;
+    std::array<std::int64_t,3> primary;
+    for(int axis=0;axis<3;axis++) {
+      if(periodic_cells) {
+        particle.proper_position_cm[axis]=std::fmod(particle.proper_position_cm[axis],periodic_box_cm);
+        if(particle.proper_position_cm[axis]<0)particle.proper_position_cm[axis]+=periodic_box_cm;
+      }
+      const double coordinate=std::floor(particle.proper_position_cm[axis]/width);
+      if(!std::isfinite(coordinate) || coordinate<=double(INT64_MIN/2) || coordinate>=double(INT64_MAX/2))
+        throw std::runtime_error("SIDM spatial native coordinate outside finite cell-index domain");
+      primary[axis]=std::int64_t(coordinate);
+      if(periodic_cells && primary[axis]>=periodic_cells)primary[axis]=periodic_cells-1;
+    }
+    for(int dx=-1;dx<=1;dx++)for(int dy=-1;dy<=1;dy++)for(int dz=-1;dz<=1;dz++) {
+      std::array<std::int64_t,3> target={{primary[0]+dx,primary[1]+dy,primary[2]+dz}};
+      if(periodic_cells)for(auto &coordinate:target)coordinate=(coordinate+periodic_cells)%periodic_cells;
+      outgoing.push_back({worker(target),{particle,primary,target}});
+    }
+  }
+  auto incoming=exchange_pair_records(communicator,outgoing,limits,result.exchange);
+  result.received_ghost_records=incoming.values.size();
+  valid=true;for(std::size_t index=0;index<incoming.values.size();index++)valid=valid &&
+      incoming.values[index].particle.owner==incoming.origins[index] && worker(incoming.values[index].target)==rank;
+  require_collective(communicator,valid,"SIDM spatial ghost source or target-cell ownership differs");
+  std::sort(incoming.values.begin(),incoming.values.end(),[](const ghost &left,const ghost &right) {
+    return std::tie(left.target,left.particle.id)<std::tie(right.target,right.particle.id);
+  });
+  for(std::size_t begin=0;begin<incoming.values.size();) {
+    std::size_t end=begin+1;while(end<incoming.values.size() && incoming.values[end].target==incoming.values[begin].target)++end;
+    std::vector<dm_neighbor_point> tree_points;tree_points.reserve(end-begin);
+    for(std::size_t index=begin;index<end;index++) {const auto &point=incoming.values[index].particle;
+      tree_points.push_back({point.id,index,point.proper_position_cm,point.proper_support_radius_cm});}
+    dm_neighbor_tree dm_tree(std::move(tree_points),periodic_box_cm,limits.memory_bytes/8);
+    for(std::size_t left=begin;left<end;left++) {
+      const auto &first=incoming.values[left];
+      if(first.primary!=first.target)continue;
+      const dm_neighbor_point target={first.particle.id,left,first.particle.proper_position_cm,first.particle.proper_support_radius_cm};
+      const auto neighbors=dm_tree.overlapping(target,result.examined_neighbors,maximum_neighbor_visits);
+      for(std::size_t right:neighbors) {
+        const auto &second=incoming.values[right];
+        if(first.particle.id>=second.particle.id)continue;
+        if(first.particle.native_type==2 && second.particle.native_type==2)continue;
+        double displacement[3];
+        for(int axis=0;axis<3;axis++) {
+          displacement[axis]=first.particle.proper_position_cm[axis]-second.particle.proper_position_cm[axis];
+          if(periodic_cells)displacement[axis]-=periodic_box_cm*std::nearbyint(displacement[axis]/periodic_box_cm);
+        }
+        const double distance=std::hypot(displacement[0],std::hypot(displacement[1],displacement[2]));
+        if(distance>=first.particle.proper_support_radius_cm+second.particle.proper_support_radius_cm)continue;
+        const double overlap=measured_kernel_overlap(kernel_kind,distance,first.particle.proper_support_radius_cm,
+            second.particle.proper_support_radius_cm,kernel_origin_bound);
+        if(overlap==0)continue;
+        if(result.pairs.size()>=limits.maximum_local_pairs)
+          throw std::runtime_error("SIDM native candidate pair count exceeds its recorded allocation");
+        result.pairs.push_back({first.particle.id,second.particle.id,first.particle.owner,second.particle.owner,overlap,
+            first.particle.mass_msun,second.particle.mass_msun,first.particle.native_type,second.particle.native_type});
+      }
+    }
+    begin=end;
+  }
+  return result;
+}
+}
+#endif
diff --git a/shipped/src/sidm/sidm.cc b/shipped/src/sidm/sidm.cc
new file mode 100644
index 0000000..c2ff9f4
--- /dev/null
+++ b/shipped/src/sidm/sidm.cc
@@ -0,0 +1,49 @@
+#include "gadgetconfig.h"
+#ifdef RESEARCH_SIDM_REFERENCE
+#include "sidm.h"
+#include "research_moller_transport.h"
+#include <cmath>
+#include <memory>
+#include <stdexcept>
+namespace research_sidm {
+namespace {std::unique_ptr<differential_table> retained_native_model;}
+const differential_table *native_differential_model(){return retained_native_model.get();}
+void prepare_native_differential_model(int kind,const char *path,const char *model_hash,const char *table_hash)
+{
+  if(kind!=3){retained_native_model.reset();return;}
+  if(!path || !*path || !model_hash || !table_hash)throw std::runtime_error("Native SIDM retained differential table identity missing");
+  if(retained_native_model && retained_native_model->model_hash()==model_hash && retained_native_model->table_hash()==table_hash)return;
+  retained_native_model.reset(new differential_table(differential_table::read(path,model_hash,table_hash)));
+}
+double native_total_cross_section(int kind,double normalization,double speed,double scale)
+{
+  if(!std::isfinite(normalization) || normalization<0 || !std::isfinite(speed) || speed<0)
+    throw std::runtime_error("Native SIDM physical cross section input invalid");
+  if(normalization==0)return 0;
+  if(kind==3) {
+    if(!retained_native_model)throw std::runtime_error("Native SIDM differential table was not prepared");
+    return normalization*retained_native_model->total_cross_section(speed);
+  }
+  if(kind==0)return normalization;
+  if(!std::isfinite(scale) || scale<=0)throw std::runtime_error("Native SIDM angular screening scale invalid");
+  if(kind==1)return normalization/(1+std::pow(speed/scale,2));
+  if(kind==2)return normalization*moller_total_factor(speed,scale);
+  throw std::runtime_error("Unknown native SIDM differential model");
+}
+long double native_sigma_speed_bound(int kind,long double normalization,long double upper,long double scale)
+{
+  if(!std::isfinite(normalization) || normalization<0 || !std::isfinite(upper) || upper<0)
+    throw std::runtime_error("Native SIDM rate bound input invalid");
+  if(normalization==0 || upper==0)return 0;
+  if(kind==3) {
+    if(!retained_native_model)throw std::runtime_error("Native SIDM rate bound lacks retained differential model");
+    return normalization*retained_native_model->maximum_sigma_speed(upper);
+  }
+  if(kind==0)return normalization*upper;
+  // Moller total <= Rutherford total for the declared unpolarized symmetry
+  // normalization. This bound remains valid for exchange interference.
+  const long double velocity=std::min(upper,scale);
+  return normalization*velocity/(1+(velocity/scale)*(velocity/scale));
+}
+}
+#endif
diff --git a/shipped/src/sidm/sidm.h b/shipped/src/sidm/sidm.h
new file mode 100644
index 0000000..7088f4c
--- /dev/null
+++ b/shipped/src/sidm/sidm.h
@@ -0,0 +1,64 @@
+/* Native elastic SIDM differential-table interface. Rates use proper cgs
+ * quantities; interpolation is linear in cosine and logarithmic in speed.
+ * A retained differential interpolant never silently changes convention.
+ */
+#ifndef RESEARCH_NATIVE_ELASTIC_SIDM_H
+#define RESEARCH_NATIVE_ELASTIC_SIDM_H
+#include "research_angular_transport.h"
+#include <cstdint>
+#include <string>
+#include <vector>
+#include <array>
+#include <memory>
+
+namespace research_sidm {
+class differential_table
+{
+ public:
+  static differential_table read(const std::string &path,const std::string &model_hash,const std::string &table_sha256);
+  double total_cross_section(double speed_kms) const;
+  double differential_cross_section(double speed_kms,double cosine) const;
+  double sample_cosine(double speed_kms,double uniform,double minimum_angle,bool folded) const;
+  angular_transport_moments moments(double speed_kms,double split_angle,bool folded) const;
+  long double maximum_sigma_speed(long double speed_upper_kms) const;
+  const std::string &model_hash() const {return model_hash_;}
+  const std::string &table_hash() const {return table_hash_;}
+  double minimum_speed() const {return velocities_.front();}
+  double maximum_speed() const {return velocities_.back();}
+  std::uint64_t memory_bytes() const {return std::uint64_t(velocities_.capacity()+cosines_.capacity()+differential_.capacity())*sizeof(double);}
+ private:
+  std::vector<double> row(double speed) const;
+  std::vector<double> velocities_,cosines_,differential_;
+  int low_policy_=0,high_policy_=0;
+  double absolute_tolerance_=0,relative_tolerance_=0;
+  std::string model_hash_,table_hash_;
+};
+const differential_table *native_differential_model();
+void prepare_native_differential_model(int angular_kind,const char *path,const char *model_hash,const char *table_hash);
+double native_total_cross_section(int angular_kind,double normalization,double speed,double screening_velocity);
+long double native_sigma_speed_bound(int angular_kind,long double normalization,long double speed_upper,long double screening_velocity);
+
+struct dm_neighbor_point
+{
+  std::uint64_t id;
+  std::size_t source_index;
+  std::array<double,3> position_cm;
+  double support_cm;
+};
+/* Dedicated DM tree uses GADGET4 basenode nextnode/sibling topology. Its point
+ * population is fine/coarse DM support ghosts, independent of gas SPH lists.
+ */
+class dm_neighbor_tree
+{
+ public:
+  dm_neighbor_tree(std::vector<dm_neighbor_point> points,double periodic_box_cm,std::uint64_t memory_bytes);
+  ~dm_neighbor_tree();
+  dm_neighbor_tree(const dm_neighbor_tree &)=delete;
