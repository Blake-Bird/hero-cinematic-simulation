+#include "util_demangle.hpp"
+
+using namespace r123;
+int main(int, char **){
+    r123array4x32 c = {{}};
+    r123array4x32 r;
+
+#if R123_USE_64BIT
+    ReinterpretCtr<r123array4x32, Threefry2x64> p;
+    Threefry2x64::key_type kp = {{}};
+    r = p(c, kp);
+    std::cout << demangle(p) << ": " << r << "\n";
+#else
+    std::cout << "Can't test ReinterpretCtr with R123_USE_64BIT = 0\n";
+#endif
+    return 0;
+}
