+/* Copy-on-write append keeps public and archived generations immutable. */
+void native_copy_hdf5_for_append(const char *source, char *stage)
+{
+  int input = open(source, O_RDONLY);
+  int output = mkstemp(stage);
+  if(input < 0 || output < 0) Terminate("cannot open HDF5 append copy");
+  char buffer[65536];
+  while(true)
+    {
+      ssize_t n = read(input, buffer, sizeof(buffer));
+      if(n < 0 && errno == EINTR) continue;
+      if(n < 0) Terminate("cannot read HDF5 append source");
+      if(n == 0) break;
+      ssize_t offset = 0;
+      while(offset < n)
+        {
+          ssize_t wrote = write(output, buffer + offset, n - offset);
+          if(wrote < 0 && errno == EINTR) continue;
+          if(wrote <= 0) Terminate("cannot write HDF5 append stage");
+          offset += wrote;
+        }
+    }
+  if(fsync(output) != 0 || close(output) != 0 || close(input) != 0)
+    Terminate("cannot flush HDF5 append copy");
+}
