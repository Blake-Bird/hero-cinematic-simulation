+void ngenic::ngenic_initialize_velocity_transfer(void)
+{
+  WdmVelocityTransferEnabled = false;
+  WdmVelocityK.clear();
+  WdmVelocityCorrection.clear();
+
+  if(All.NgenicVelocityTransferFile[0] == '\0' || std::string(All.NgenicVelocityTransferFile) == "none")
+    return;
+
+  std::ifstream input(All.NgenicVelocityTransferFile);
+  if(!input)
+    Terminate("NGENIC: cannot open scale-dependent velocity table '%s'\n", All.NgenicVelocityTransferFile);
+
+  std::string line;
+  while(std::getline(input, line))
+    {
+      if(line.empty() || line[0] == '#')
+        continue;
+      std::istringstream row(line);
+      double k, correction;
+      if(!(row >> k >> correction))
+        Terminate("NGENIC: malformed scale-dependent velocity row in '%s'\n", All.NgenicVelocityTransferFile);
+      if(!std::isfinite(k) || !std::isfinite(correction) || k <= 0 || correction <= 0)
+        Terminate("NGENIC: non-positive or non-finite scale-dependent velocity entry\n");
+      if(!WdmVelocityK.empty() && k <= WdmVelocityK.back())
+        Terminate("NGENIC: scale-dependent velocity k values must be strictly increasing\n");
+      WdmVelocityK.push_back(k);
+      WdmVelocityCorrection.push_back(correction);
+    }
+
+  if(WdmVelocityK.size() < 3)
+    Terminate("NGENIC: scale-dependent velocity table needs at least three rows\n");
+
+  const double kfund = 2.0 * M_PI / All.BoxSize * 1000.0;
+  const double kmax = sqrt(3.0) * M_PI * NGENIC / All.BoxSize * 1000.0;
+  if(WdmVelocityK.front() > kfund || WdmVelocityK.back() < kmax)
+    Terminate("NGENIC: velocity table covers [%.8g, %.8g] h/Mpc but the particle mesh requires [%.8g, %.8g]\n",
+              WdmVelocityK.front(), WdmVelocityK.back(), kfund, kmax);
+
+  WdmVelocityTransferEnabled = true;
+  mpi_printf("NGENIC: using CLASS/AxiCLASS scale-dependent velocity response over %.8g..%.8g h/Mpc (%zu rows)\n",
+             WdmVelocityK.front(), WdmVelocityK.back(), WdmVelocityK.size());
+}
+
+double ngenic::ngenic_velocity_correction(double k_h_mpc) const
+{
+  if(k_h_mpc < WdmVelocityK.front() || k_h_mpc > WdmVelocityK.back())
+    Terminate("NGENIC: velocity table does not cover k=%.8g h/Mpc\n", k_h_mpc);
+
+  auto upper = std::lower_bound(WdmVelocityK.begin(), WdmVelocityK.end(), k_h_mpc);
+  if(upper == WdmVelocityK.begin())
+    return WdmVelocityCorrection.front();
+  if(upper == WdmVelocityK.end())
+    return WdmVelocityCorrection.back();
+
+  const size_t i1 = static_cast<size_t>(upper - WdmVelocityK.begin());
+  const size_t i0 = i1 - 1;
+  const double fraction = (log(k_h_mpc) - log(WdmVelocityK[i0])) /
+                          (log(WdmVelocityK[i1]) - log(WdmVelocityK[i0]));
+  return WdmVelocityCorrection[i0] + fraction * (WdmVelocityCorrection[i1] - WdmVelocityCorrection[i0]);
 }
 
