 def out1(options, fname):
+    # Digest relative source names, source bytes and exact compile-time options.
+    root = Path(__file__).resolve().parents[1]
+    digest = hashlib.sha256(json.dumps(options, sort_keys=True).encode())
+    for path in sorted((root / 'src').rglob('*')):
+        if path.is_file() and path.suffix in ('.h', '.cc', '.cpp'):
+            digest.update(path.relative_to(root).as_posix().encode() + b'\0')
+            digest.update(path.read_bytes())
+    for path in (root / 'Makefile', root / 'buildsystem/config.py'):
+        digest.update(path.read_bytes())
+    fingerprint = Path(fname).parent / 'research_restart_fingerprint.h'
+    fingerprint.write_text('static const char research_restart_fingerprint[] = "' + digest.hexdigest() + '";\n')
