+def filter_registry(fin, section):
+    if not fin.name.endswith('.py'):
+        return filter_readme_config(fin)
+    tree = ast.parse(fin.read(), filename=fin.name)
+    matches = [node for node in tree.body if isinstance(node, ast.Assign)
+               and any(isinstance(target, ast.Name) and target.id == section for target in node.targets)]
+    if len(matches) != 1:
+        raise ValueError('Missing or duplicate build registry: ' + section)
+    values = ast.literal_eval(matches[0].value)
+    if not isinstance(values, set) or any(not isinstance(value, str) for value in values):
+        raise ValueError('Build registry must be a literal set of option names')
+    return values
     
     
