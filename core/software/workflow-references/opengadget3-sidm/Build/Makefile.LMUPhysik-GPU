MPICHLIB = -L/software/opt/el_9/x86_64/spack/2024.07/spack/opt/spack/linux-almalinux9-x86_64_v3/nvhpc-24.3/openmpi-5.0.0-b776sruptm5xzudweridffylb2a7qz6x/lib -lmpi

FFTW_INCL = -I/software/opt/el_9/x86_64/spack/2024.07/spack/opt/spack/linux-almalinux9-x86_64_v3/nvhpc-24.3/fftw-3.3.10-vntwizzyzsb355l7rufrufacmaxibpst/include
