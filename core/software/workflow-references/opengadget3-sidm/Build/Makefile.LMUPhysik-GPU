OPTIMIZE = -std=c++23 -O3
CC=nvc++
CXX=nvc++

# for OpenACC -mp=multicore 
ifeq (ACC_OPENACC,$(filter ACC_OPENACC,$(CONFIGVARS)))
    OPTIMIZE += -mp=multicore -acc
endif

# for OpenMP: -mp -mp=gpu -target=gpu
ifeq (ACC_OPENMP,$(filter ACC_OPENMP,$(CONFIGVARS)))
    OPTIMIZE += -mp=gpu -target=gpu
endif

# if you want to use nsys then add -lnvToolsExt to compiler options
ifeq (TIMER_NVTX,$(filter TIMER_NVTX,$(CONFIGVARS)))
    OPTIMIZE += -lnvToolsExt
endif

CC_ACC_FLAGS = -gpu=ccnative
CXX += $(CC_ACC_FLAGS)
CC += $(CC_ACC_FLAGS)

