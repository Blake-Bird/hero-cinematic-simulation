CC=mpic++
CXX=mpic++

CC_ACC_FLAGS = -acc=gpu -gpu=cc80,mem:separate:pinnedalloc -mp=multicore -Minfo=accel -Wl,-z,noexecstack \
-Wall -Wextra -v -mavx -mavx2 -march=native  -mtune=native

CXX += $(CC_ACC_FLAGS)
CC += $(CC_ACC_FLAGS)

OPTIMIZE = -std=c++17 -O3

MPICHLIB=
FFTW_INCL =
FFTW_LIBS = -L/path/to/lib  -lpthread  -lfftw3_omp
GSL_LIBS = -L/path/to/lib -lgsl -lgslcblas -lm
