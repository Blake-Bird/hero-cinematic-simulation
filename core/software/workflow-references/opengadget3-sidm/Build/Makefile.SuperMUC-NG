CC        = mpiicpx
CXX       = mpiicpx

GSL_INCL = -I$(GSL_ROOT_DIR)/include
GSL_LIBS = -L$(GSL_ROOT_DIR)/lib

HDF5_INCL = $(HDF5_INC)
HDF5_LIBS  = $(HDF5_SHLIB)

MPICHLIB =

FFTW_INCL= $(FFTW_INC)
FFTW_LIBS= -L$(FFTW_LIBDIR)

OPTIMIZE =  -std=c++17 -g -O2 -xcommon-avx512 -fimf-precision=high -fimf-use-svml=true -DH5_USE_16_API -qopenmp
