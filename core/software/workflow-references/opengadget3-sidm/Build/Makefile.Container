OPTIMIZE  = -std=c++17 -g -O2 -fopenmp -Wno-cpp -Wno-format -Wno-aggressive-loop-optimizations -Wno-unused-result -Wno-pragmas

MPICHLIB  = 
HDF5_INCL = -I/usr/include/hdf5/serial

# Specify path depending on architecture
ARCH := $(shell uname -m)

ifeq ($(ARCH),x86_64)
HDF5_LIBS = -L/usr/lib/x86_64-linux-gnu/hdf5/serial -lhdf5
else ifeq ($(ARCH),aarch64)
HDF5_LIBS = -L/usr/lib/aarch64-linux-gnu/hdf5/serial -lhdf5
endif
