CC = nvc++
CXX = nvc++
CC_ACC_FLAGS = -acc -gpu=cc80 -mp -Wl,-z,noexecstack
CXX += $(CC_ACC_FLAGS)
CC += $(CC_ACC_FLAGS)

OPTIMIZE = -std=c++17 -O2

FFTW_INCL = -I/home/users/u102033/FFTW3/include
FFTW_LIBS = -L/home/users/u102033/FFTW3/lib -lfftw3f_mpi -lfftw3f_threads -lfftw3f -lpthread
MPICHLIB = -L/apps/USE/easybuild/staging/2023.1/software/OpenMPI/4.1.5-NVHPC-23.7-CUDA-12.2.0/lib -lmpi
GSL_LIBS = -lgsl -lgslcblas -lm
