    "sha256": {
      "initial_ic": "FILL_EXACT_PARENT_ASSET_SHA256",
      "source_manifest": "FILL_EXACT_PARENT_ASSET_SHA256",
      "noise": "FILL_EXACT_PARENT_ASSET_SHA256",
      "spectrum_manifest": "FILL_EXACT_PARENT_ASSET_SHA256"
    },
    "seeds_by_level": {
      "7": 421
    }
  },
  "epochs": {
    "z_start": null,
    "z_end": null,
    "backbone_redshifts": [],
    "maximum_redshift_error": 1e-07
  },
  "resources": {
    "mpi_ranks": 1,
    "omp_threads": 1,
    "memory_gib": 8.0,
    "disk_gib": 64.0,
    "maximum_stage_count": 32,
    "wall_hours": 24.0,
    "maximum_tracers": 10000000
  },
  "generator": {
    "binary": "../../core/software/music2/build/MUSIC",
