{
  "schema": "research-workflow-v1",
  "resources": {
    "mpi_ranks": 1,
    "omp_threads": 1,
    "memory_gib": 1.0,
    "disk_gib": 4.0,
    "maximum_stage_count": 4
  },
  "followup_limits": {
    "maximum_children": 0,
    "maximum_depth": 0
  },
  "physics_spec": {
    "physics": "dm"
  },
  "capabilities": [],
  "requested_products": [
    "measured_display"
  ],
  "stages": [
    {
      "stage_id": "display",
      "kind": "display_products",
      "parameters": {
        "request": {
          "json_input": "block31_display_products.example.json"
        },
        "request_base": "{request_base}",
        "destination": "{generation}/measured",
        "memory_gib": 1.0
      },
      "outputs": {
        "measured_display": "measured/display.json",
        "display_assembly": "display-assembly.json"
      }
    }
  ]
}
